# APS Demo — Environment Configuration
# Copy this file to .env and adjust values as needed.
# Never commit .env to version control.

# ===========================================
# Server Configuration
# ===========================================

# Port for the API server
PORT=3001

# Node environment (development, production, test)
NODE_ENV=development

# ===========================================
# Client Branding
# ===========================================
# All fields below are read at runtime by /api/config.
# Swap these values to rebrand the entire UI without touching code.

# Short display name shown in the header and page title
# Examples: APS | Acme Utilities | Pacific Power
CLIENT_NAME=APS

# Subtitle shown under the logo in the header
CLIENT_TAGLINE=Arizona Public Service — Real-time Dashboard

# Primary accent colour (hex) — used for header background and highlights
CLIENT_COLOR_PRIMARY=#003087

# Secondary / call-to-action colour (hex) — used for KPI cards and badges
CLIENT_COLOR_SECONDARY=#E87722

# Build-time frontend fallback (used by Vite if /api/config is unavailable)
VITE_CLIENT_NAME=APS

# API base URL for the frontend (defaults to http://localhost:3001)
VITE_API_URL=http://localhost:3001
